# Use the ignored .env file for real credentials.
ADMIN_ACCOUNTS=[{"name":"Support Admin","email":"admin@example.invalid","password":"replace-with-a-long-random-secret"}]

# TLS verification is enabled by default, including hostname validation.
# Set this when the server uses a private or self-signed CA certificate.
# DATABASE_SSL_CA=./certs/mariadb-ca.pem

# Local MySQL Workbench development only. Requires DATABASE_URL to use
# localhost/127.0.0.1/::1 and NODE_ENV=development. Omits TLS entirely.
# NODE_ENV=development
# DATABASE_TLS=false
#
# The local server handshake may advertise caching_sha2_password. Prefer a
# trusted server RSA public key file (obtained from the server administrator):
# DATABASE_CACHING_RSA_PUBLIC_KEY=./certs/mysql-caching-rsa-public-key.pem
# If no trusted key file is available, this explicitly requests the key from
# that loopback server. Leave unset when TLS is enabled or outside local dev.
# DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=true
